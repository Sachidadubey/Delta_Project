<% layout("/layouts/boilerplate") %>

  <style>
    .new-wrapper {
      max-width: 700px;
      margin: 2.5rem auto 4rem auto;
      padding: 0 1rem;
    }

    .new-header {
      margin-bottom: 2rem;
    }

    .new-header h3 {
      font-size: 1.6rem;
      font-weight: 700;
      color: #222;
      margin-bottom: 4px;
    }

    .new-header p {
      color: #888;
      font-size: 14px;
    }

    .new-card {
      background: white;
      border-radius: 20px;
      border: 1px solid #ebebeb;
      padding: 2rem;
      box-shadow: 0 2px 16px rgba(0, 0, 0, 0.06);
    }

    .form-label {
      font-size: 13px;
      font-weight: 600;
      color: #444;
      margin-bottom: 6px;
    }

    .form-control {
      border-radius: 10px !important;
      border: 1px solid #e0e0e0 !important;
      padding: 10px 14px !important;
      font-size: 14px;
      background: #fafafa;
      transition: border-color 0.2s, box-shadow 0.2s;
    }

    .form-control:focus {
      border-color: #fe424d !important;
      box-shadow: 0 0 0 3px rgba(254, 66, 77, 0.1) !important;
      background: white;
      outline: none;
    }

    textarea.form-control {
      min-height: 110px;
      resize: vertical;
    }

    .section-divider {
      border: none;
      border-top: 1px solid #f0f0f0;
      margin: 1.5rem 0;
    }

    .section-label {
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: #aaa;
      margin: 0 0 1rem 0;
    }

    .input-group-text {
      border-radius: 10px 0 0 10px !important;
      border: 1px solid #e0e0e0 !important;
      background: #f0f0f0;
      color: #666;
      font-size: 14px;
      font-weight: 600;
    }

    .input-group .form-control {
      border-radius: 0 10px 10px 0 !important;
      border-left: none !important;
    }

    .add-btn {
      width: 100%;
      background: #fe424d !important;
      color: white !important;
      border: none !important;
      border-radius: 10px !important;
      padding: 13px !important;
      font-size: 15px;
      font-weight: 700;
      transition: background 0.2s, transform 0.1s;
    }

    .add-btn:hover {
      background: #e0333e !important;
      transform: scale(1.01);
    }

    .back-link {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      color: #888;
      font-size: 13px;
      text-decoration: none;
      margin-bottom: 1.5rem;
      transition: color 0.2s;
    }

    .back-link:hover {
      color: #222;
    }

    .upload-hint {
      font-size: 12px;
      color: #aaa;
      margin-top: 5px;
    }
  </style>

  <div class="new-wrapper">

    <a href="/listings" class="back-link">
      <i class="fa-solid fa-arrow-left"></i> Back to listings
    </a>

    <div class="new-header">
      <h3>Create a New Listing</h3>
      <p>Share your space with travelers around the world</p>
    </div>

    <div class="new-card">
      <form method="post" action="/listings/" novalidate class="needs-validation" enctype="multipart/form-data">

        <div class="section-label">Basic Info</div>

        <div class="mb-3">
          <label class="form-label">Title</label>
          <input name="listing[title]" type="text" class="form-control"
            placeholder="e.g. Cozy Mountain Cabin with Forest Views" required />
          <div class="valid-feedback">Title looks good!</div>
          <div class="invalid-feedback">Please enter a title</div>
        </div>

        <div class="mb-3">
          <label class="form-label">Description</label>
          <textarea name="listing[description]" class="form-control"
            placeholder="Describe what makes your place special — amenities, vibe, nearby attractions..."
            required></textarea>
          <div class="invalid-feedback">Please enter a description</div>
        </div>

        <div class="mb-3">
          <label class="form-label">Category</label>
          <select name="listing[category]" class="form-control" required>
            <option value="" disabled selected>Select a category</option>
            <% ["Trending","Rooms","Mountain","Camping","Farms"].forEach(cat=> { %>
              <option value="<%= cat %>">
                <%= cat %>
              </option>
              <% }) %>
          </select>
          <div class="invalid-feedback">Please select a category</div>
        </div>

        <hr class="section-divider" />
        <div class="section-label">Listing Image</div>

        <div class="mb-3">
          <label class="form-label">Upload Photo</label>
          <input name="listing[image]" type="file" class="form-control" accept="image/*" required />
          <p class="upload-hint"><i class="fa-solid fa-circle-info me-1"></i>Max 5MB. JPG, PNG, WEBP accepted.</p>
          <div class="invalid-feedback">Please upload an image</div>
        </div>

        <hr class="section-divider" />
        <div class="section-label">Location & Pricing</div>

        <div class="row g-3 mb-3">
          <div class="col-md-4">
            <label class="form-label">Price / night</label>
            <div class="input-group">
              <span class="input-group-text">₹</span>
              <input name="listing[price]" type="number" class="form-control" placeholder="1200" required />
            </div>
            <div class="invalid-feedback">Enter a valid price</div>
          </div>
          <div class="col-md-8">
            <label class="form-label">Location</label>
            <input name="listing[location]" type="text" class="form-control" placeholder="e.g. Jaipur, Rajasthan"
              required />
            <div class="invalid-feedback">Enter a valid location</div>
          </div>
        </div>

        <div class="mb-4">
          <label class="form-label">Country</label>
          <input name="listing[country]" type="text" class="form-control" placeholder="e.g. India" required />
          <div class="invalid-feedback">Enter a valid country</div>
        </div>

        <button class="btn add-btn">
          <i class="fa-solid fa-plus me-2"></i> Create Listing
        </button>

      </form>
    </div>

  </div>

  <script src="/js/script.js"></script>