<% layout("/layouts/boilerplate") %>

  <style>
    .edit-wrapper {
      max-width: 700px;
      margin: 2.5rem auto 4rem auto;
      padding: 0 1rem;
    }

    .edit-header {
      margin-bottom: 2rem;
    }

    .edit-header h3 {
      font-size: 1.6rem;
      font-weight: 700;
      color: #222;
      margin-bottom: 4px;
    }

    .edit-header p {
      color: #888;
      font-size: 14px;
    }

    .edit-card {
      background: white;
      border-radius: 20px;
      border: 1px solid #ebebeb;
      padding: 2rem;
      box-shadow: 0 2px 16px rgba(0, 0, 0, 0.06);
    }

    .form-label {
      font-size: 13px;
      font-weight: 600;
      color: #444;
      margin-bottom: 6px;
    }

    .form-control {
      border-radius: 10px !important;
      border: 1px solid #e0e0e0 !important;
      padding: 10px 14px !important;
      font-size: 14px;
      color: #222;
      transition: border-color 0.2s, box-shadow 0.2s;
      background: #fafafa;
    }

    .form-control:focus {
      border-color: #fe424d !important;
      box-shadow: 0 0 0 3px rgba(254, 66, 77, 0.1) !important;
      background: white;
      outline: none;
    }

    textarea.form-control {
      min-height: 110px;
      resize: vertical;
    }

    .section-divider {
      border: none;
      border-top: 1px solid #f0f0f0;
      margin: 1.5rem 0;
    }

    .image-preview-box {
      display: flex;
      align-items: center;
      gap: 1rem;
      background: #f7f7f7;
      border-radius: 12px;
      padding: 12px 16px;
      border: 1px solid #ebebeb;
      margin-bottom: 1rem;
    }

    .image-preview-box img {
      width: 100px;
      height: 70px;
      object-fit: cover;
      border-radius: 8px;
    }

    .image-preview-box span {
      font-size: 13px;
      color: #888;
    }

    .price-prefix {
      position: relative;
    }

    .price-prefix span {
      position: absolute;
      left: 14px;
      top: 50%;
      transform: translateY(-50%);
      color: #888;
      font-size: 14px;
      font-weight: 600;
    }

    .price-prefix input {
      padding-left: 28px !important;
    }

    .edit-btn {
      background-color: #fe424d !important;
      color: white !important;
      border: none !important;
      border-radius: 10px !important;
      padding: 12px 32px !important;
      font-size: 15px;
      font-weight: 600;
      width: 100%;
      transition: background 0.2s, transform 0.1s;
      margin-top: 0.5rem;
    }

    .edit-btn:hover {
      background-color: #e0333e !important;
      transform: scale(1.01);
    }

    .back-link {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      color: #888;
      font-size: 13px;
      text-decoration: none;
      margin-bottom: 1.5rem;
      transition: color 0.2s;
    }

    .back-link:hover {
      color: #222;
    }

    .input-group-text {
      border-radius: 10px 0 0 10px !important;
      border: 1px solid #e0e0e0 !important;
      background: #f0f0f0;
      color: #666;
      font-size: 14px;
      font-weight: 600;
    }

    .input-group .form-control {
      border-radius: 0 10px 10px 0 !important;
      border-left: none !important;
    }
  </style>

  <div class="edit-wrapper">

    <a href="/listings/<%= listing._id %>" class="back-link">
      <i class="fa-solid fa-arrow-left"></i> Back to listing
    </a>

    <div class="edit-header">
      <h3>Edit your listing</h3>
      <p>Update the details below and save your changes</p>
    </div>

    <div class="edit-card">
      <form method="POST" action="/listings/<%= listing._id %>/edit?_method=PUT" novalidate class="needs-validation"
        enctype="multipart/form-data">

        <!-- TITLE -->
        <div class="mb-3">
          <label class="form-label">Title</label>
          <input name="listing[title]" value="<%= listing.title %>" type="text" class="form-control"
            placeholder="e.g. Cozy Mountain Cabin" required />
          <div class="valid-feedback">Looks good!</div>
          <div class="invalid-feedback">Please enter a title</div>
        </div>

        <!-- DESCRIPTION -->
        <div class="mb-3">
          <label class="form-label">Description</label>
          <textarea name="listing[description]" class="form-control"
            placeholder="Describe what makes this place special..." required><%= listing.description %></textarea>
          <div class="invalid-feedback">Please enter a description</div>
        </div>

        <!-- CATEGORY -->
        <div class="mb-3">
          <label class="form-label">Category</label>
          <select name="listing[category]" class="form-control" required>
            <option value="" disabled>Select a category</option>
            <% ["Trending","Rooms","Mountain","Camping","Farms"].forEach(cat=> { %>
              <option value="<%= cat %>" <%=listing.category===cat ? 'selected' : '' %>>
                <%= cat %>
              </option>
              <% }) %>
          </select>
          <div class="invalid-feedback">Please select a category</div>
        </div>

        <hr class="section-divider" />

        <!-- CURRENT IMAGE -->
        <div class="mb-3">
          <label class="form-label">Current Image</label>
          <div class="image-preview-box">
            <img src="<%= originalImageUrl %>" alt="Current listing image" />
            <span>This is your current listing photo. Upload a new one below to replace it.</span>
          </div>
        </div>

        <!-- NEW IMAGE UPLOAD -->
        <div class="mb-3">
          <label class="form-label">Upload New Image <span
              style="color:#aaa; font-weight:400;">(optional)</span></label>
          <input name="listing[image]" type="file" class="form-control" accept="image/*" />
        </div>

        <hr class="section-divider" />

        <!-- PRICE + LOCATION -->
        <div class="row g-3 mb-3">
          <div class="col-md-4">
            <label class="form-label">Price / night</label>
            <div class="input-group">
              <span class="input-group-text">₹</span>
              <input name="listing[price]" value="<%= listing.price %>" type="number" class="form-control"
                placeholder="1200" required />
            </div>
            <div class="invalid-feedback">Enter a valid price</div>
          </div>
          <div class="col-md-8">
            <label class="form-label">Location</label>
            <input name="listing[location]" value="<%= listing.location %>" type="text" class="form-control"
              placeholder="e.g. Jaipur, Rajasthan" required />
            <div class="invalid-feedback">Enter a valid location</div>
          </div>
        </div>

        <!-- COUNTRY -->
        <div class="mb-4">
          <label class="form-label">Country</label>
          <input name="listing[country]" value="<%= listing.country %>" type="text" class="form-control"
            placeholder="e.g. India" required />
          <div class="invalid-feedback">Enter a valid country</div>
        </div>

        <!-- SUBMIT -->
        <button class="btn edit-btn">
          <i class="fa-solid fa-floppy-disk me-2"></i> Save Changes
        </button>

      </form>
    </div>

  </div>

  <script src="/js/script.js"></script>